{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigests',
    ':automergeBranch',
    ':dependencyDashboard',
    ':disableRateLimiting',
    ':semanticCommits',
  ],
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  schedule: [
    'every weekend',
  ],
  ignorePaths: [
    '**/*.sops.*',
  ],
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  helmfile: {
    managerFilePatterns: [
      '/(^|/)helmfile\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kustomize: {
    managerFilePatterns: [
      '/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  packageRules: [
    {
      description: 'CoreDNS Group',
      groupName: 'CoreDNS',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/coredns/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
    },
    {
      description: 'Flux Operator Group',
      groupName: 'Flux Operator',
      matchPackageNames: [
        '/flux-operator/',
        '/flux-instance/',
      ],
      matchDatasources: [
        'docker',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
    },
    {
      description: 'Spegel Group',
      groupName: 'Spegel',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/spegel/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
    },
    {
      description: 'Auto-merge GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      automergeType: 'branch',
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
        'digest',
      ],
      minimumReleaseAge: '3 days',
      ignoreTests: true,
    },
    {
      // Each dario release bundles a newer Claude Code template, and Anthropic
      // gates new models on it (docs/dario.md), so dario skips the weekend
      // schedule and merges straight to main; majors still wait for a PR.
      // 09:00-14:59 UTC = 02:00-07:59 PDT: the Recreate restart lands before
      // the day starts and before dario-notify's 09:00 PT check.
      description: 'Auto-merge dario daily',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/askalf/dario',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      schedule: [
        '* 9-14 * * *',
      ],
      automerge: true,
      automergeType: 'branch',
      automergeSchedule: [
        '* 9-14 * * *',
      ],
      ignoreTests: true,
    },
    {
      // List B (docs/renovate.md): apps that update unattended, matched by
      // folder, so an image shared with a list-A app (say, Postgres) still
      // waits for review. Majors wait for a PR here too. Same early-morning
      // window as dario. Homebox is held out while a switch to
      // hay-kot/homebox, uncommitted on 2026-10-22, edits the same lines as
      // its pending update.
      description: 'Auto-merge less critical apps',
      matchFileNames: [
        'kubernetes/apps/default/echo/**',
        'kubernetes/apps/default/echo-envoy/**',
        'kubernetes/apps/default/echo-internal/**',
        'kubernetes/apps/default/homarr/**',
        'kubernetes/apps/default/homepage/**',
        'kubernetes/apps/default/httpbin/**',
        'kubernetes/apps/default/httpbin2/**',
        'kubernetes/apps/default/mealie/**',
        'kubernetes/apps/default/n8n/**',
        'kubernetes/apps/default/paperless-ngx/**',
        'kubernetes/apps/default/photoprism/**',
        'kubernetes/apps/default/podinfo/**',
        'kubernetes/apps/default/shlink/**',
        'kubernetes/apps/default/shlink-web-client/**',
        'kubernetes/apps/infra/ntfy/**',
        'kubernetes/apps/infra/organizr/**',
        'kubernetes/apps/infra/podinfo2/**',
        'kubernetes/apps/infra/podinfo3/**',
        'kubernetes/apps/media/audiobookshelf/**',
        'kubernetes/apps/media/overseerr/**',
        'kubernetes/apps/media/plex/**',
        'kubernetes/apps/media/prowlarr/**',
        'kubernetes/apps/media/radarr/**',
        'kubernetes/apps/media/readarr/**',
        'kubernetes/apps/media/sabnzbd/**',
        'kubernetes/apps/media/sonarr/**',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      schedule: [
        '* 9-14 * * *',
      ],
      automerge: true,
      automergeType: 'branch',
      automergeSchedule: [
        '* 9-14 * * *',
      ],
      ignoreTests: true,
    },
    {
      // Sonarr v5 is still a pre-release (GitHub flags every 5.0.0.x build as
      // one as of 2026-10-22) and its database migration is one-way. The
      // home-operations image publishes those builds under plain tags, so hold
      // it here. Drop this rule once Sonarr ships v5 as a stable release.
      description: 'Hold Sonarr on v4',
      matchPackageNames: [
        'ghcr.io/home-operations/sonarr',
      ],
      allowedVersions: '<5',
    },
    {
      // Spegel 0.7 dropped containerd 2.0 support (it only advertises new
      // images through content events, which containerd 2.1 introduced) and
      // 0.8 refuses to start below containerd 2.2; 0.8's registry Service also
      // sets trafficDistribution: PreferSameNode, which Kubernetes 1.32 rejects.
      // The nodes run Talos 1.9.5 (containerd 2.0.3, Kubernetes 1.32.3). Raise
      // this to '<0.8.0' once Talos is on 1.11+ (containerd 2.1) and drop it
      // once Talos is on 1.13+ (containerd 2.2.3) with Kubernetes 1.33+.
      description: 'Hold Spegel on 0.6',
      matchPackageNames: [
        'ghcr.io/spegel-org/helm-charts/spegel',
      ],
      allowedVersions: '<0.7.0',
    },
    {
      // talosctl, talhelper, kubectl, flux and cilium-cli stay manual: they
      // should move with the cluster's versions, not ahead of them.
      description: 'Auto-merge CLI tools',
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        '!aqua:siderolabs/talos',
        '!aqua:budimanjojo/talhelper',
        '!aqua:kubernetes/kubernetes/kubectl',
        '!aqua:fluxcd/flux2',
        '!aqua:cilium/cilium-cli',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      semanticCommitType: 'feat',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}})!:',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      semanticCommitType: 'feat',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      semanticCommitType: 'fix',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchUpdateTypes: [
        'digest',
      ],
      semanticCommitType: 'chore',
      commitMessageExtra: '( {{currentDigestShort}} → {{newDigestShort}} )',
    },
    {
      matchDatasources: [
        'docker',
      ],
      semanticCommitScope: 'container',
      commitMessageTopic: 'image {{depName}}',
    },
    {
      matchDatasources: [
        'helm',
      ],
      semanticCommitScope: 'helm',
      commitMessageTopic: 'chart {{depName}}',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      semanticCommitType: 'ci',
      semanticCommitScope: 'github-action',
      commitMessageTopic: 'action {{depName}}',
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      semanticCommitScope: 'github-release',
      commitMessageTopic: 'release {{depName}}',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'type/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'type/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'type/patch',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      addLabels: [
        'renovate/container',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      addLabels: [
        'renovate/helm',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      addLabels: [
        'renovate/github-action',
      ],
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      addLabels: [
        'renovate/github-release',
      ],
    },
  ],
  customManagers: [
    {
      description: 'Process annotated dependencies',
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/).+\\.env(?:\\.j2)?$/',
        '/(^|/).+\\.sh(?:\\.j2)?$/',
        '/(^|/).+\\.ya?ml(?:\\.j2)?$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)',
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
    },
  ],
}
